    "context_rotation_config.py",
    "bin",
    "SKILL.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yavdaanalytics/context-optimiser.git"
  },
  "homepage": "https://github.com/yavdaanalytics/context-optimiser",
